# ============================================================
# 女装B2B行业平台 · 环境变量示例
# 复制为 .env 后按需填写。Demo 模式（DATA_DRIVER=memory）下
# 除 PORT / JWT_SECRET 外全部可留空，服务会使用内置演示数据启动。
# ============================================================

# ---------- 运行模式 ----------
# memory = 内置演示数据（零依赖，默认） | mysql = 生产数据库
DATA_DRIVER=memory
NODE_ENV=development
PORT=3000
# 对外可访问的基础地址（用于拼接分享链接 / OSS 回调）
PUBLIC_BASE_URL=http://localhost:3000

# ---------- 数据库（DATA_DRIVER=mysql 时生效） ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=women_fashion_b2b

# ---------- Redis（会话 / 配额计数 / 热榜） ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- RabbitMQ（异步审核 / 推送 / 统计） ----------
RABBITMQ_URL=amqp://localhost:5672

# ---------- Elasticsearch（全文检索） ----------
ES_HOST=localhost
ES_PORT=9200

# ---------- JWT ----------
JWT_SECRET=wfb-dev-secret-change-me
JWT_EXPIRES_IN=7d

# ---------- 微信小程序 ----------
WX_APPID=your_appid
WX_SECRET=your_secret
# 内容安全 V2 回调（微信公众平台 → 开发 → 开发设置 → 消息推送）
WX_CONTENT_SECURITY_TOKEN=your_token
WX_CONTENT_SECURITY_AES_KEY=your_aes_key

# ---------- 抖音小程序 ----------
DY_APPID=your_appid
DY_SECRET=your_secret

# ---------- 支付宝小程序 ----------
ALI_APPID=your_appid
ALI_PRIVATE_KEY=your_key

# ---------- AI 网关（统一 OpenAI 协议，可切换供应商） ----------
# 留空时功能板块自动降级为「本地规则引擎」演示模式，仍可完整体验流程
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your_api_key
AI_DEFAULT_MODEL=deepseek-chat

# ---------- 内容安全 ----------
CONTENT_SECURITY_PROVIDER=mock
CONTENT_SECURITY_TOKEN=your_token

# ---------- 对象存储 ----------
OSS_ACCESS_KEY=your_key
OSS_SECRET=your_secret
OSS_BUCKET=your_bucket
OSS_REGION=oss-cn-hangzhou
# public = 直接用 OSS 域名；local = 存到本机 uploads/ 并由 API 托管
UPLOAD_DRIVER=local
