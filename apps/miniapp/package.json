{
  "name": "@wfb/miniapp",
  "version": "6.0.0",
  "private": true,
  "description": "女装B2B行业平台 · Taro 4.3 多端（微信/抖音/支付宝小程序 + H5）",
  "browserslist": ["last 3 versions", "Android >= 4.1", "ios >= 8"],
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:tt": "taro build --type tt",
    "build:alipay": "taro build --type alipay",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-html": "4.3.0",
    "@tarojs/plugin-platform-alipay": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-tt": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "@wfb/shared-api": "workspace:*",
    "@wfb/shared-types": "workspace:*",
    "@wfb/shared-utils": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.26.0",
    "@babel/preset-react": "7.26.3",
    "@babel/runtime": "7.26.0",
    "@tarojs/cli": "4.3.0",
    "@tarojs/taro-loader": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/webpack-env": "1.18.5",
    "babel-preset-taro": "4.3.0",
    "postcss": "8.5.6",
    "sass": "1.105.1",
    "typescript": "5.9.3",
    "webpack": "5.97.1"
  }
}
